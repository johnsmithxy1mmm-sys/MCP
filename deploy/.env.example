# ---------------------------------------------------------------------------
# predmarket-mcp — production environment template.
# Copy to `.env` (next to docker-compose.yml) and fill in. NEVER commit `.env`.
#   cp deploy/.env.example deploy/.env
# Everything here is read by the server at boot; secrets live ONLY in this file.
# ---------------------------------------------------------------------------

# === Engine ================================================================
# mock = offline stubs (safe default); live = real Polymarket/Kalshi adapters.
# Live needs outbound egress to gamma-api.polymarket.com, clob.polymarket.com,
# api.elections.kalshi.com. Without egress the engine degrades to empty.
CORE_ENGINE=live
HTTP_TIMEOUT=15

# Free-tier delay (seconds) — paid tools are realtime.
FREE_TIER_DELAY_SECONDS=60

# === Monetization (x402) ===================================================
# Master switch. Leave FALSE to run usage-first (no charging), flip to TRUE to
# enforce 402 + metering on paid tools.
PAID_ENABLED=false
PAYMENT_RAIL=x402
# Your payee wallet + settlement network.
X402_OPERATOR_WALLET=0xYOUR_WALLET_HERE
X402_NETWORK=base
# Real settlement: point at a Coinbase / self-hosted x402 facilitator
# (/verify + /settle). Unset => structural MockFacilitator (no on-chain move).
# X402_FACILITATOR_URL=https://x402.facilitator.example
# Replay-guard TTL for consumed payments (30d).
NONCE_TTL_SECONDS=2592000

# === Autonomous features (all optional; safe defaults are OFF) ==============
# Background scanner that fires watches off the hot path (poll becomes drain-only).
ALERT_ENGINE=on
ALERT_ENGINE_INTERVAL=30
# Push fired alerts to your webhook (optional).
# ALERT_WEBHOOK_URL=https://your-app.example/alerts
# ALERT_WEBHOOK_SECRET=change-me

# Real-time WSS price ingestion into the history store.
STREAMING=on

# LLM analyst (resolution-risk + basis diff). Needs the API key.
ANALYST_ENABLED=on
ANTHROPIC_API_KEY=sk-ant-...
ANALYST_MODEL=claude-opus-4-8
ANALYST_MAX_ENRICH=3

# Options-implied probability cross-check (Deribit; needs egress to deribit.com).
OPTIONS_ENABLED=on

# On-chain anchoring of the track-record Merkle root.
ANCHOR_ENABLED=on
ANCHOR_NETWORK=base
# Set an RPC + funded key for REAL anchoring; without them a deterministic
# MockChainAnchor is used (no chain write).
# ANCHOR_RPC_URL=https://mainnet.base.org
# ANCHOR_PRIVATE_KEY=0xYOUR_FUNDED_ANCHOR_KEY
# ANCHOR_CHAIN_ID=8453
ANCHOR_MIN_INTERVAL=3600

# Semantic matcher (needs the `semantic` build extra + weights baked in).
# MATCHER=hybrid
# EMBED_BACKEND=fastembed

# Third venue (Manifold) as an extra consensus anchor.
# MANIFOLD_ENABLED=on

# === Shared state for horizontal scaling ===================================
# Point every server instance at the same Redis (x402 replay + rate limit +
# watch queues) and the same Postgres history DSN. Compose wires both below.
REDIS_URL=redis://redis:6379/0
HISTORY_DB_URL=postgresql://predmarket:CHANGE_ME_DB_PASSWORD@postgres:5432/predmarket
HISTORY_RETENTION_DAYS=90

# Local SQLite stores (metering/receipts, reconciliation, watches) live on the
# mounted volume; fine for a single instance. For multi-instance, metering can
# move to Postgres later — watches already use Redis when REDIS_URL is set.
METERING_DB_URL=sqlite:////data/metering.db
RECON_DB_URL=sqlite:////data/reconciliation.db
WATCH_DB_URL=sqlite:////data/watches.db
ANCHOR_DB_URL=sqlite:////data/anchors.db

# === Cost model =============================================================
# The numbers behind "honest realizable edge". Defaults follow the published
# schedules; re-verify at launch (venue fee pages change) — a stale rate here
# silently corrupts every edge the server sells. `deploy/preflight.py` prints
# the resulting costs on a real basket so you can sanity-check them.
# Kalshi: fee = ceil(rate * contracts * P * (1-P)), taker only (makers free).
KALSHI_FEE_RATE=0.07
# Polymarket: no base trading fee at time of writing.
POLYMARKET_FEE_RATE=0.0
# Per-leg settlement cost. Polymarket flow is largely relayed/gasless, so this
# is a conservative non-zero placeholder; Kalshi is custodial (no chain write).
GAS_USD_POLYMARKET=0.05
GAS_USD_KALSHI=0.0

# === Autonomy ===============================================================
# Background resolver: polls venues for settled outcomes and feeds them into the
# track record. WITHOUT THIS the moat never grows — calibration, survival, house
# Brier and the leaderboard all stay empty regardless of traffic. Turn it on.
RESOLUTION_ENGINE=on
RESOLUTION_INTERVAL=3600

# === Ops ====================================================================
# Per-client rate limit (requests/min); 0 disables.
RATE_LIMIT_RPM=120
# Per-venue circuit breaker.
CIRCUIT_FAIL_MAX=5
CIRCUIT_RESET_TIMEOUT=30
# Structured JSON logs for aggregation.
LOG_FORMAT=json
LOG_LEVEL=INFO

# Trust: Ed25519 signing key (32-byte hex/base64 seed) for verifiable
# provenance served at /pubkey. Without it every response is marked unsigned and
# /pubkey 404s — the trust story IS the product, so set this.
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# SIGNING_KEY_ED25519=

# Operator-only /revenue reconciliation (charged vs settled). Unset => the
# endpoint is disabled (404) rather than exposed.
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# ADMIN_TOKEN=

# Database password used by the postgres service (must match HISTORY_DB_URL).
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD

# Bind
HOST=0.0.0.0
PORT=8000
